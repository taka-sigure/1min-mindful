---
import '../styles/global.css';
import { profileData, linkItems } from '../data/links';

const siteTitle = `${profileData.accountName} | ${profileData.handle}`;
const siteDescription = `${profileData.accountName}（${profileData.handle}）のリンク集です。夜、寝る前に聴いているものや、普段使っている道具をまとめています。`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "/favicon.svg"} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#121316" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-[#111215] text-neutral-300 antialiased font-sans selection:bg-neutral-800 selection:text-neutral-200">
    <div class="mx-auto max-w-sm px-5 py-12">
      
      <!-- ヘッダー -->
      <header class="text-center">
        <h1 class="text-base font-medium tracking-widest text-neutral-200">
          {profileData.accountName}
        </h1>
        <p class="mt-1 text-xs text-neutral-500 tracking-wider">
          {profileData.handle}
        </p>

        <!-- 呼吸サークル（静かなアニメーション） -->
        <div class="mt-8 mb-10 flex flex-col items-center justify-center">
          <div class="relative flex h-28 w-28 items-center justify-center">
            <div class="breathing-circle rounded-full border border-neutral-700/60 bg-neutral-800/30 flex items-center justify-center shadow-sm">
              <span id="breathing-text" class="text-xs text-neutral-400 tracking-widest select-none">すって</span>
            </div>
          </div>
          <p class="mt-3 text-[11px] text-neutral-600 tracking-wider">
            円に合わせて、ゆっくり呼吸
          </p>
        </div>
      </header>

      <!-- リンク一覧（無印・Appleライクな引き算のデザイン） -->
      <main class="space-y-3">
        {linkItems.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="group block rounded-xl border border-neutral-800/80 bg-neutral-900/60 p-4 transition duration-200 hover:border-neutral-700 hover:bg-neutral-900 active:scale-[0.99]"
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-[13px] font-medium text-neutral-200 group-hover:text-white transition">
                  {item.title}
                </p>
                <p class="mt-0.5 text-xs text-neutral-500">
                  {item.description}
                </p>
              </div>
              <span class="text-neutral-600 text-sm group-hover:text-neutral-400 transition ml-2">→</span>
            </div>
          </a>
        ))}
      </main>

      <!-- フッター -->
      <footer class="mt-14 text-center">
        <p class="text-xs text-neutral-600 tracking-wider">
          {profileData.footerMessage}
        </p>
        <p class="mt-4 text-[10px] text-neutral-700">
          {profileData.disclaimer}
        </p>
      </footer>
    </div>

    <!-- 呼吸アニメーション（静かでなめらかな挙動） -->
    <style>
      @keyframes breatheSmooth {
        0%, 100% {
          width: 70px;
          height: 70px;
          opacity: 0.5;
        }
        25% {
          width: 104px;
          height: 104px;
          opacity: 0.9;
        }
        50% {
          width: 104px;
          height: 104px;
          opacity: 0.85;
        }
        100% {
          width: 70px;
          height: 70px;
          opacity: 0.5;
        }
      }

      .breathing-circle {
        animation: breatheSmooth 16s infinite ease-in-out;
      }
    </style>

    <script>
      const textElem = document.getElementById('breathing-text');
      if (textElem) {
        const updateText = () => {
          const now = Date.now() % 16000;
          if (now < 4000) {
            textElem.innerText = 'すって';
          } else if (now < 8000) {
            textElem.innerText = 'とめて';
          } else {
            textElem.innerText = 'はいて';
          }
        };
        setInterval(updateText, 500);
      }
    </script>
  </body>
</html>
