---
import { affiliateConfig } from '../config/affiliate';

interface Props {
  pid?: string;
}

const { pid = affiliateConfig.valueCommerce.pid } = Astro.props;
const isConfigured = pid && pid !== 'YOUR_VALUECOMMERCE_PID';
---

{isConfigured && (
  <>
    <!-- ValueCommerce LinkSwitch: 通常のリンクをクリック時に自動でアフィリエイトリンクに変換 -->
    <script type="text/javascript" is:inline define:vars={{ pid }}>
      var vc_pid = pid;
    </script>
    <script type="text/javascript" src="//as.valuecommerce.com/as.js" async is:inline></script>
  </>
)}
