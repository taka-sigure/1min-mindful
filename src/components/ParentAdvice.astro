---
interface Props {
  title?: string;
}

const { title = '息子・娘夫婦に贈るときの「気配りポイント」' } = Astro.props;
---

<div class="my-6 rounded-2xl border-2 border-emerald-300 bg-emerald-50/70 p-5 md:p-6">
  <div class="flex items-center gap-2.5 text-emerald-900 font-bold text-base md:text-lg mb-3">
    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-600 text-white text-sm">
      💡
    </span>
    <h4>{title}</h4>
  </div>

  <div class="text-slate-700 text-base leading-relaxed space-y-2.5">
    <slot />
  </div>

  <div class="mt-4 pt-3 border-t border-emerald-200/80 text-xs text-emerald-800 flex items-center gap-1.5">
    <span>✓</span>
    <span>「親に気兼ねなく喜んでもらう」ためのチェック項目です</span>
  </div>
</div>
