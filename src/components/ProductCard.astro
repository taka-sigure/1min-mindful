---
interface Props {
  title: string;
  description?: string;
  price?: string;
  amazonUrl?: string;
  rakutenUrl?: string;
  yahooUrl?: string;
  badge?: string;
}

const {
  title,
  description,
  price,
  amazonUrl,
  rakutenUrl,
  yahooUrl,
  badge,
} = Astro.props;

const hasMultipleMalls = [amazonUrl, rakutenUrl, yahooUrl].filter(Boolean).length > 1;
---

<div class="relative rounded-xl border border-neutral-800 bg-neutral-900/60 p-4 transition-all duration-200 hover:border-neutral-700 hover:bg-neutral-900/80">
  {badge && (
    <div class="mb-2">
      <span class="inline-block rounded-full bg-neutral-800 px-2 py-0.5 text-[10px] font-medium tracking-wider text-neutral-300 border border-neutral-700/80">
        {badge}
      </span>
    </div>
  )}

  <div class="mb-3">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-[13px] font-medium text-neutral-200 leading-snug">
        {title}
      </h3>
      {price && (
        <span class="shrink-0 text-[11px] font-mono text-neutral-400">
          {price}
        </span>
      )}
    </div>
    {description && (
      <p class="mt-1 text-xs text-neutral-500 leading-relaxed">
        {description}
      </p>
    )}
  </div>

  <!-- 3大モール比較ボタン（ポイント離脱防止＆CVR最大化） -->
  <div class="grid grid-cols-3 gap-2 pt-2.5 border-t border-neutral-800/80">
    {amazonUrl && (
      <a
        href={amazonUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="flex flex-col items-center justify-center rounded-lg bg-[#232F3E]/70 border border-amber-500/20 px-2 py-2 text-center transition hover:bg-[#232F3E] hover:border-amber-500/40 active:scale-95"
      >
        <span class="text-[11px] font-medium text-amber-200">Amazon</span>
        <span class="text-[9px] text-neutral-400 scale-90">翌日配送</span>
      </a>
    )}
    {rakutenUrl && (
      <a
        href={rakutenUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="flex flex-col items-center justify-center rounded-lg bg-[#BF0000]/15 border border-red-500/30 px-2 py-2 text-center transition hover:bg-[#BF0000]/25 hover:border-red-500/50 active:scale-95"
      >
        <span class="text-[11px] font-medium text-red-300">楽天市場</span>
        <span class="text-[9px] text-red-200/70 scale-90">ポイント</span>
      </a>
    )}
    {yahooUrl && (
      <a
        href={yahooUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="flex flex-col items-center justify-center rounded-lg bg-[#FF0033]/15 border border-rose-500/30 px-2 py-2 text-center transition hover:bg-[#FF0033]/25 hover:border-rose-500/50 active:scale-95"
      >
        <span class="text-[11px] font-medium text-rose-300">Yahoo!</span>
        <span class="text-[9px] text-rose-200/70 scale-90">PayPay</span>
      </a>
    )}
  </div>
</div>
