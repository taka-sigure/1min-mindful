---
interface Props {
  title: string;
  rakutenUrl: string;
  amazonUrl: string;
  price?: string;
  imageUrl?: string;
  shopName?: string;
  isOfficial?: boolean;
  notes?: string;
}

const {
  title,
  rakutenUrl,
  amazonUrl,
  price,
  imageUrl,
  shopName = '公式・認定取扱店',
  isOfficial = true,
  notes,
} = Astro.props;
---

<div class="my-8 rounded-2xl border-2 border-amber-200 bg-white p-5 shadow-sm transition hover:shadow-md md:p-6">
  {isOfficial && (
    <div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 border border-emerald-200">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>安心の定価・正規品案内（転売防止）</span>
    </div>
  )}

  <div class="flex flex-col gap-5 md:flex-row md:items-center">
    {imageUrl && (
      <div class="flex shrink-0 justify-center md:w-44">
        <img
          src={imageUrl}
          alt={title}
          class="h-40 w-40 rounded-xl object-contain bg-slate-50 p-2 border border-slate-100"
          loading="lazy"
        />
      </div>
    )}

    <div class="flex-1">
      <h3 class="text-lg font-bold text-slate-900 leading-snug md:text-xl">
        {title}
      </h3>

      <div class="mt-2 flex flex-wrap items-baseline gap-3 text-sm text-slate-600">
        {price && (
          <span class="text-base font-bold text-rose-600 md:text-lg">
            参考価格: {price}
          </span>
        )}
        <span class="text-xs text-slate-500">（取扱目安: {shopName}）</span>
      </div>

      {notes && (
        <p class="mt-2 text-sm text-slate-600 bg-amber-50/70 p-2.5 rounded-lg border border-amber-100">
          💡 <strong>ポイント:</strong> {notes}
        </p>
      )}

      <!-- 楽天 & Amazon 専用ボタン（50代以上が押しやすい特大・高コントラスト） -->
      <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={rakutenUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex flex-col items-center justify-center rounded-xl bg-[#bf0000] px-4 py-3.5 text-white shadow-sm transition hover:bg-[#a60000] active:scale-[0.98]"
        >
          <span class="text-base font-bold tracking-wide">楽天市場で見る</span>
          <span class="text-xs text-red-100 mt-0.5">ポイントが貯まる・使える</span>
        </a>

        <a
          href={amazonUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex flex-col items-center justify-center rounded-xl bg-[#ff9900] px-4 py-3.5 text-slate-900 shadow-sm transition hover:bg-[#e68a00] active:scale-[0.98]"
        >
          <span class="text-base font-bold tracking-wide">Amazonで見る</span>
          <span class="text-xs text-slate-800 mt-0.5">翌日お届け・在庫確認</span>
        </a>
      </div>

      <p class="mt-3 text-center text-xs text-slate-400">
        ※セール状況や在庫により価格が変動する場合があります。リンク先で最新情報をご確認ください。
      </p>
    </div>
  </div>
</div>
