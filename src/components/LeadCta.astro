---
interface Props {
  title: string;
  description: string;
  tagline?: string;
  microCopy: string;
  ctaText: string;
  affiliateUrl: string;
  highlight?: boolean;
  badge?: string;
}

const {
  title,
  description,
  tagline = "無料体験",
  microCopy,
  ctaText,
  affiliateUrl,
  highlight = true,
  badge,
} = Astro.props;
---

<div class={`relative rounded-xl border p-4 transition-all duration-200 ${
  highlight
    ? 'border-indigo-500/40 bg-gradient-to-b from-indigo-950/30 to-neutral-900/60 shadow-lg shadow-indigo-950/20'
    : 'border-neutral-800 bg-neutral-900/60'
}`}>
  {badge && (
    <div class="mb-2">
      <span class="inline-block rounded-full bg-indigo-500/20 px-2.5 py-0.5 text-[10px] font-medium tracking-wider text-indigo-300 border border-indigo-500/30">
        {badge}
      </span>
    </div>
  )}

  <div>
    <div class="flex items-center gap-1.5">
      <span class="text-[10px] font-mono tracking-wider text-indigo-400 uppercase">
        {tagline}
      </span>
    </div>
    <h3 class="mt-0.5 text-[14px] font-semibold text-neutral-100">
      {title}
    </h3>
    <p class="mt-1 text-xs text-neutral-400 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-3.5">
    <!-- CVRを高める心理的安心マイクロコピー -->
    <div class="mb-2 flex items-center justify-center gap-1.5 text-[11px] text-neutral-300">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{microCopy}</span>
    </div>

    <!-- 特大・高コントラストCTAボタン -->
    <a
      href={affiliateUrl}
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="group flex w-full items-center justify-center gap-1.5 rounded-lg bg-gradient-to-r from-neutral-100 via-white to-neutral-200 py-2.5 px-4 text-xs font-semibold text-neutral-900 shadow-md transition-all hover:brightness-105 active:scale-[0.98]"
    >
      <span>{ctaText}</span>
      <span class="text-neutral-500 transition group-hover:translate-x-0.5">→</span>
    </a>
  </div>
</div>
