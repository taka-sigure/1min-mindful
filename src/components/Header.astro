---
const ageLinks = [
  { label: '0〜1歳', href: '/age/0-1' },
  { label: '2〜3歳', href: '/age/2-3' },
  { label: '4〜6歳', href: '/age/4-6' },
  { label: '小学生', href: '/age/elementary' },
];

const categoryLinks = [
  { label: '📺 テレビ話題', href: '/category/tv' },
  { label: '🧩 知育玩具', href: '/category/educational' },
  { label: '🎒 入学・イベント', href: '/category/events' },
];
---

<header class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-amber-100 shadow-sm">
  <div class="mx-auto max-w-5xl px-4 py-3 sm:px-6">
    <div class="flex items-center justify-between gap-4">
      <!-- サイトロゴ & キャッチコピー -->
      <div>
        <p class="text-xs font-semibold text-amber-700 tracking-wide">
          じいじ・ばあばの失敗しない孫プレゼント選び
        </p>
        <a href="/" class="group flex items-center gap-2">
          <span class="text-2xl font-black tracking-tight text-slate-900 group-hover:text-amber-600 transition">
            まごギフト<span class="text-amber-600">Navi</span>
          </span>
          <span class="rounded bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800">
            mago-gift.com
          </span>
        </a>
      </div>

      <!-- 右側：安心マーク -->
      <div class="hidden sm:flex items-center gap-2 text-xs font-medium text-slate-500 bg-slate-50 px-3 py-1.5 rounded-full border border-slate-200">
        <span class="text-emerald-600 font-bold">✓</span>
        <span>楽天・Amazon公式取扱店のみ掲載</span>
      </div>
    </div>

    <!-- 年齢別クイックナビ（シニアが最も探しやすい導線） -->
    <div class="mt-3 flex items-center gap-2 overflow-x-auto pb-1 pt-1 scrollbar-none text-sm">
      <span class="shrink-0 text-xs font-bold text-slate-500 mr-1">年齢で探す:</span>
      {ageLinks.map((item) => (
        <a
          href={item.href}
          class="shrink-0 rounded-full border border-amber-200 bg-amber-50/70 px-3.5 py-1.5 font-bold text-amber-900 hover:bg-amber-100 transition active:scale-95"
        >
          {item.label}
        </a>
      ))}

      <span class="shrink-0 mx-1 text-slate-300">|</span>

      {categoryLinks.map((item) => (
        <a
          href={item.href}
          class="shrink-0 rounded-full border border-slate-200 bg-white px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50 transition"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>
